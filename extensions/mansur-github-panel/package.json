{
  "name": "mansur-github-panel",
  "displayName": "Mansur GitHub Panel",
  "description": "GitHub Explorer panel — Git Push, New Branch, Branch Select",
  "version": "1.1.1",
  "publisher": "mansur",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:mansurGithubPanel"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "mansurGithubPanel",
          "name": "GitHub"
        }
      ]
    },
    "commands": [
      {
        "command": "mansurGithubPanel.refresh",
        "title": "Refresh GitHub Panel"
      }
    ]
  }
}